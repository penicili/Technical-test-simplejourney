pipeline {
  agent any

  parameters {
    string(name: 'REGISTRY', defaultValue: '', description: 'mis. docker.io/username (kosong = skip push)')
  }

  environment {
    IMAGE_NAME = 'hello-devops'
    NAME       = 'hello'
    HEALTH_URL = 'http://host.docker.internal:8080/'
  }

  options { timestamps() }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
        script {
          env.VERSION = sh(returnStdout: true, script: 'git rev-parse --short HEAD').trim()
        }
        echo "Version: ${env.VERSION}"
      }
    }

    stage('Test') {
      steps {
        sh 'docker build --target test -t ${IMAGE_NAME}:test .'
      }
    }

    stage('Build Image') {
      steps {
        sh 'docker build --build-arg VERSION=${VERSION} -t ${IMAGE_NAME}:${VERSION} .'
        sh 'docker images ${IMAGE_NAME}:${VERSION}'
      }
    }

    stage('Push') {
      when { expression { params.REGISTRY?.trim() } }
      steps {
        withCredentials([usernamePassword(credentialsId: 'registry-creds',
                                          usernameVariable: 'REG_USER',
                                          passwordVariable: 'REG_PASS')]) {
          sh '''
            echo "$REG_PASS" | docker login -u "$REG_USER" --password-stdin
            docker tag  ${IMAGE_NAME}:${VERSION} ${REGISTRY}/${IMAGE_NAME}:${VERSION}
            docker push ${REGISTRY}/${IMAGE_NAME}:${VERSION}
          '''
        }
      }
    }

    stage('Deploy') {
      steps {
        sh '''
          set -e
          cid=$(docker create ${IMAGE_NAME}:${VERSION})
          docker cp "$cid:/app" ./app-new
          docker rm "$cid" >/dev/null
          sh deploy.sh ./app-new ${VERSION}
        '''
      }
    }
  }

  post {
    always  { sh 'rm -f app-new || true' }
    failure { echo 'Pipeline gagal, cek stage yang merah.' }
  }
}